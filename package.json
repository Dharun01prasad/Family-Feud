{
  "name": "feud-night-live",
  "private": true,
  "workspaces": ["frontend", "backend"],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm:dev -w backend\" \"npm:dev -w frontend\"",
    "build": "npm run build -w frontend && npm run build -w backend",
    "test": "npm run test -w backend",
    "db:push": "npm run db:push -w backend",
    "db:seed": "npm run db:seed -w backend",
    "db:import-questions": "npm run db:import-questions -w backend",
    "db:upgrade-16": "npm run db:upgrade-16 -w backend"
  },
  "devDependencies": { "concurrently": "^9.1.2" }
}
